/* ====== Base Reset ====== */
* { box-sizing: border-box; }
html, body { height: 100%; }

:root{
  --wall-1: #f3eadb;         /* 벽/석고톤 */
  --wall-2: #e9dcc9;
  --wood-1: #8b5a3c;         /* 나무 */
  --wood-2: #6f442d;
  --wood-3: #a06a45;
  --ink: #1f1f1f;
  --soft: rgba(0,0,0,0.08);
  --shadow: rgba(0,0,0,0.18);
}

body{
  margin: 0;
  font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  color: var(--ink);

  /* 간이역 실내: 따뜻한 벽 + 위쪽 채광 느낌 */
  background:
    radial-gradient(1200px 700px at 50% 0%, rgba(255,255,255,0.85), transparent 60%),
    linear-gradient(180deg, var(--wall-1), var(--wall-2));

  /* 바닥 느낌을 살짝 */
  position: relative;
  overflow-x: hidden;
}

/* 바닥(플로어) */
body::after{
  content:"";
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 34vh;
  background:
    linear-gradient(180deg, rgba(0,0,0,0.00), rgba(0,0,0,0.10)),
    repeating-linear-gradient(
      90deg,
      rgba(120, 70, 40, 0.15) 0px,
      rgba(120, 70, 40, 0.15) 18px,
      rgba(120, 70, 40, 0.08) 18px,
      rgba(120, 70, 40, 0.08) 36px
    ),
    linear-gradient(180deg, #d8b89b, #caa584);
  z-index: -1;
}

/* ====== Layout ====== */
.main-container{
  max-width: 860px;
  margin: 0 auto;
  padding: 34px 18px 90px;
  position: relative;
}

/* 상단에 간이역 표지판 느낌(전체 분위기) */
.main-container::before{
  content: "SMALL STATION • PLATFORM";
  display: block;
  width: fit-content;
  margin: 0 auto 18px;
  padding: 10px 14px;
  letter-spacing: 0.14em;
  font-weight: 800;
  font-size: 12px;
  color: rgba(255,255,255,0.92);

  background: linear-gradient(180deg, var(--wood-1), var(--wood-2));
  border: 1px solid rgba(0,0,0,0.15);
  border-radius: 999px;
  box-shadow: 0 10px 26px rgba(0,0,0,0.18);
}

/* 섹션 카드: 벽에 걸린 패널 같은 느낌 */
section{
  background: rgba(255,255,255,0.78);
  border: 1px solid rgba(0,0,0,0.07);
  border-radius: 18px;
  padding: 18px 16px;
  margin-top: 14px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.10);
  backdrop-filter: blur(4px);
}

/* ====== Typography ====== */
.message-section h1{
  margin: 0 0 8px;
  font-size: 28px;
  letter-spacing: 0.02em;
}

.message-section p{
  margin: 0;
  line-height: 1.6;
  color: rgba(0,0,0,0.72);
}

.drawing-section h2,
.gallery-section h2{
  margin: 0 0 10px;
  font-size: 16px;
  font-weight: 900;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: rgba(0,0,0,0.72);
}

/* ====== Window (Drawing Area) ======
   창문 프레임 + 창밖 풍경(그라데이션) 느낌 */
#drawing-area{
  height: 320px;
  border-radius: 18px;
  position: relative;
  overflow: hidden;

  /* 창밖 풍경: 하늘+구름+산+들판 */
  background:
    radial-gradient(220px 120px at 20% 22%, rgba(255,255,255,0.95), transparent 60%),
    radial-gradient(260px 140px at 68% 18%, rgba(255,255,255,0.85), transparent 62%),
    linear-gradient(180deg, #bfe9ff 0%, #e9fbff 40%, #bfe7c8 72%, #7ec09a 100%),
    linear-gradient(180deg, rgba(0,0,0,0.00), rgba(0,0,0,0.10));

  /* 창문 유리 반사 */
  box-shadow:
    inset 0 0 0 10px rgba(255,255,255,0.55),
    inset 0 0 0 12px rgba(0,0,0,0.06),
    0 12px 28px rgba(0,0,0,0.16);
}

/* 나무 창틀 */
#drawing-area::before{
  content:"";
  position:absolute;
  inset: 0;
  border-radius: 18px;
  box-shadow:
    inset 0 0 0 14px rgba(0,0,0,0.00),
    inset 0 0 0 16px rgba(0,0,0,0.10);

  /* 나무 프레임 */
  border: 16px solid transparent;
  background:
    linear-gradient(180deg, var(--wood-3), var(--wood-2)) border-box;
  -webkit-mask:
    linear-gradient(#000 0 0) padding-box,
    linear-gradient(#000 0 0) border-box;
  -webkit-mask-composite: xor;
          mask-composite: exclude;

  pointer-events:none;
}

/* 창문 가로/세로 프레임(십자) */
#drawing-area::after{
  content:"";
  position:absolute;
  inset: 16px; /* 프레임 두께만큼 안쪽 */
  border-radius: 10px;
  background:
    linear-gradient(90deg, transparent calc(50% - 4px), rgba(0,0,0,0.20) calc(50% - 4px), rgba(0,0,0,0.20) calc(50% + 4px), transparent calc(50% + 4px)),
    linear-gradient(180deg, transparent calc(50% - 4px), rgba(0,0,0,0.20) calc(50% - 4px), rgba(0,0,0,0.20) calc(50% + 4px), transparent calc(50% + 4px));
  mix-blend-mode: multiply;
  opacity: 0.25;
  pointer-events:none;
}

/* 안내 텍스트(아직 하트 찍기 전) */
#drawing-area .hint{
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  padding: 10px 12px;
  border-radius: 999px;
  font-weight: 800;
  font-size: 13px;
  color: rgba(0,0,0,0.75);
  background: rgba(255,255,255,0.72);
  border: 1px solid rgba(0,0,0,0.10);
  box-shadow: 0 10px 22px rgba(0,0,0,0.10);
}

/* ====== Buttons ====== */
.button-section{
  display:flex;
  justify-content:center;
  gap: 10px;
}

#love-button{
  border: none;
  border-radius: 999px;
  padding: 12px 18px;
  font-size: 14px;
  font-weight: 900;
  letter-spacing: 0.08em;
  cursor: pointer;
  color: rgba(255,255,255,0.95);

  background: linear-gradient(180deg, #ff5a86, #ff3f74);
  box-shadow: 0 14px 26px rgba(255, 63, 116, 0.28), 0 8px 18px rgba(0,0,0,0.14);
  transition: transform 0.08s ease, filter 0.15s ease;
}

#love-button:hover{ filter: brightness(1.03); }
#love-button:active{ transform: translateY(1px); }

/* ====== Responsive ====== */
@media (max-width: 520px){
  .main-container{ padding: 26px 14px 70px; }
  #drawing-area{ height: 280px; }
  .message-section h1{ font-size: 24px; }
}
